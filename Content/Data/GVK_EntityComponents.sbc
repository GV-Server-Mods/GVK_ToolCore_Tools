      <Id>
        <TypeId>ModStorageComponent</TypeId>
        <SubtypeId>GVK_SalvageTurretClearance</SubtypeId>
      </Id>
      <RegisteredStorageGuids>
        <guid>AB503EF1-F20D-4F3A-A7EE-E7C67638EC0A</guid>
      </RegisteredStorageGuids>
    </EntityComponent>
  </EntityComponents>
</Definitions>
