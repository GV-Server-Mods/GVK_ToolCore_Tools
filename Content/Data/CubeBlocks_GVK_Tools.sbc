<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>
        <!-- =================================================================== -->
        <!-- GVK TOOLCORE TOOLS (Deserts of Kharak Balance)                       -->
        <!-- Sorter-based ToolCore replacements & Coalition Salvage Beam Turret. -->
        <!-- =================================================================== -->

        <!-- =================================================================== -->
        <!-- 1. SALVAGE BEAM TURRET                                              -->
        <!-- =================================================================== -->
        <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
            <Id>
                <TypeId>ConveyorSorter</TypeId>
                <SubtypeId>GVK_LargeSalvageBeamTurret</SubtypeId>
            </Id>
            <DisplayName>Salvage Beam Turret</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\LG_SimpleLaserMultitool_Turret.dds</Icon>
            <Description>Heavy-duty Coalition directed-energy utility turret. Range: 150m (Weld), 100m (Grind).</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>true</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="2" z="1" />
            <ModelOffset x="0" y="1.25" z="0" />
            <Model>Models\Cubes\Large\laser_turret\LG_SimpleLaserMultitool_Turret.mwm</Model>
            <UseModelIntersection>true</UseModelIntersection>
            <Components>
                <Component Subtype="SteelPlate" Count="180" />
                <Component Subtype="Construction" Count="40" />
                <Component Subtype="LargeTube" Count="12" />
                <Component Subtype="Computer" Count="25" />
                <Component Subtype="Motor" Count="30" />
                <Component Subtype="PowerCell" Count="10" />
                <Component Subtype="SteelPlate" Count="120" />
            </Components>
            <CriticalComponent Subtype="PowerCell" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\laser_turret\LG_SimpleLaserMultitool_Turret_BS1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\laser_turret\LG_SimpleLaserMultitool_Turret_BS2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\laser_turret\LG_SimpleLaserMultitool_Turret_BS3.mwm" />
            </BuildProgressModels>
            <InventorySize>
                <X>3</X>
                <Y>3</Y>
                <Z>2</Z>
            </InventorySize>
            <BlockPairName>GVK_SalvageBeamTurret</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>40</BuildTimeSeconds>
            <Center x="0" y="0" z="0" />
            <DeformationRatio>0.2</DeformationRatio>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>190</PCU>
            <!-- Sorter base block power definition: prevents block from being treated as free 0MW sink by Keen engine -->
            <ResourceSinkGroup>Utility</ResourceSinkGroup>
            <PowerInput>0.002</PowerInput>
            <ToolValues Type="Weld">
                <Turret>
                    <TargetRadius>150</TargetRadius>
                    <Subpart>
                        <Name>GatlingTurretBase1</Name>
                        <RotationAxis>Up</RotationAxis>
                        <RotationSpeed>45</RotationSpeed>
                    </Subpart>
                    <Subpart>
                        <Name>GatlingTurretBase2</Name>
                        <RotationAxis>Right</RotationAxis>
                        <RotationSpeed>30</RotationSpeed>
                        <MinRotation>-30</MinRotation>
                        <MaxRotation>125</MaxRotation>
                    </Subpart>
                    <AimingTolerance>10</AimingTolerance>
                </Turret>
                <PickUpFloatings>true</PickUpFloatings>
                <EffectShape>Line</EffectShape>
                <WorkOrder>Backward</WorkOrder>
                <WorkOrigin>Emitter</WorkOrigin>
                <WorkRate>1</WorkRate>
                <Speed>1</Speed>
                <UpdateInterval>20</UpdateInterval>
                <AffectOwnGrid>false</AffectOwnGrid>
                <CacheBlocks>true</CacheBlocks>
                <Emitter>detector_shiptool_1</Emitter>
                <Offset x="0" y="0" z="0" />
                <Radius>2.5</Radius>
                <Length>150</Length>
                <HarvestRatio>1</HarvestRatio>
                <ActivePower>0.75</ActivePower>
                <!-- ToolCore requires non-zero IdlePower; if omitted or 0, ToolCore evaluates required==0 as powered even on dead unpowered grids -->
                <IdlePower>0.002</IdlePower>
                <NonFriendlyMult>1</NonFriendlyMult>
                <DamageCharacters>false</DamageCharacters>
                <Action Type="Primary" SizeRatio="1" SpeedRatio="1" HarvestRatio="1" />
                <Event Trigger="Firing">
                    <Beam>
                        <Start>detector_shiptool_1</Start>
                        <EndLocation>Hit</EndLocation>
                        <Material>LaserMultitool_Beam</Material>
                        <Width>0.4</Width>
                        <Color>
                            <X>2.5</X>
                            <Y>10</Y>
                            <Z>25</Z>
                            <W>1</W>
                        </Color>
                    </Beam>
                </Event>
                <Event Trigger="RayHit">
                    <ParticleEffect>
                        <Name>LaserTurretWeldHit</Name>
                        <Location>Hit</Location>
                    </ParticleEffect>
                    <Sound>
                        <Name>ToolLrgWeldMetal</Name>
                    </Sound>
                </Event>
            </ToolValues>
            <ToolValues Type="Grind">
                <Turret>
                    <TargetRadius>150</TargetRadius>
                    <Subpart>
                        <Name>GatlingTurretBase1</Name>
                        <RotationAxis>Up</RotationAxis>
                        <RotationSpeed>45</RotationSpeed>
                    </Subpart>
                    <Subpart>
                        <Name>GatlingTurretBase2</Name>
                        <RotationAxis>Right</RotationAxis>
                        <RotationSpeed>30</RotationSpeed>
                        <MinRotation>-30</MinRotation>
                        <MaxRotation>125</MaxRotation>
                    </Subpart>
                    <AimingTolerance>15</AimingTolerance>
                </Turret>
                <PickUpFloatings>true</PickUpFloatings>
                <EffectShape>Line</EffectShape>
                <WorkOrder>Forward</WorkOrder>
                <WorkOrigin>Emitter</WorkOrigin>
                <WorkRate>1</WorkRate>
                <Speed>1</Speed>
                <UpdateInterval>20</UpdateInterval>
                <Emitter>detector_shiptool_1</Emitter>
                <Offset x="0" y="0" z="0" />
                <Radius>2.5</Radius>
                <Length>150</Length>
                <HarvestRatio>1</HarvestRatio>
                <ActivePower>0.75</ActivePower>
                <IdlePower>0.002</IdlePower>
                <NonFriendlyMult>0.25</NonFriendlyMult>
                <DamageCharacters>true</DamageCharacters>
                <AffectOwnGrid>false</AffectOwnGrid>
                <CacheBlocks>true</CacheBlocks>
                <Action Type="Primary" SizeRatio="1" SpeedRatio="1" HarvestRatio="1" />
                <Event Trigger="Firing">
                    <Beam>
                        <Start>detector_shiptool_1</Start>
                        <EndLocation>Hit</EndLocation>
                        <Material>LaserMultitool_Beam</Material>
                        <Width>0.4</Width>
                        <Color>
                            <X>20</X>
                            <Y>8</Y>
                            <Z>2</Z>
                            <W>1</W>
                        </Color>
                    </Beam>
                </Event>
                <Event Trigger="RayHit">
                    <ParticleEffect>
                        <Name>LaserTurretGrindHit</Name>
                        <Location>Hit</Location>
                    </ParticleEffect>
                    <Sound>
                        <Name>ToolLrgGrindIdle</Name>
                    </Sound>
                </Event>
            </ToolValues>
        </Definition>

        <!-- =================================================================== -->
        <!-- 1. LARGE BLOCK DRILL                                                -->
        <!-- =================================================================== -->
        <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
            <Id>
                <TypeId>ConveyorSorter</TypeId>
                <SubtypeId>GVK_LargeBlockDrill</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_Drill</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\drill.dds</Icon>
            <Description>Description_Drill</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>true</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="3" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\drill.mwm</Model>
            <PlaceDecals>false</PlaceDecals>
            <UseModelIntersection>true</UseModelIntersection>
            <UsesDeformation>false</UsesDeformation>
            <DeformationRatio>0.2</DeformationRatio>
            <Components>
                <Component Subtype="SteelPlate" Count="180" />
                <Component Subtype="Construction" Count="40" />
                <Component Subtype="LargeTube" Count="12" />
                <Component Subtype="Motor" Count="5" />
                <Component Subtype="Computer" Count="5" />
                <Component Subtype="SteelPlate" Count="120" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
            <MountPoints>
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Bottom" StartX="0" StartY="2" EndX="1" EndY="3" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Left" StartX="2" StartY="0" EndX="3" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\DrillConstruction_1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\DrillConstruction_2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\DrillConstruction_3.mwm" />
            </BuildProgressModels>
            <VoxelPlacement>
                <StaticMode>
                    <PlacementMode>OutsideVoxel</PlacementMode>
                    <MaxAllowed>0.2</MaxAllowed>
                    <MinAllowed>0</MinAllowed>
                </StaticMode>
                <DynamicMode>
                    <PlacementMode>OutsideVoxel</PlacementMode>
                    <MaxAllowed>0.2</MaxAllowed>
                    <MinAllowed>0.01</MinAllowed>
                </DynamicMode>
            </VoxelPlacement>
            <BlockPairName>GVK_Drill</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>30</BuildTimeSeconds>
            <Center x="0" y="0" z="2" />
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>190</PCU>
            <ResourceSinkGroup>Defense</ResourceSinkGroup>
            <PowerInput>0.002</PowerInput>
            <InventorySize>
                <X>1.7</X>
                <Y>1.7</Y>
                <Z>1.75</Z>
            </InventorySize>
            <ToolValues Type="Drill">
                <EffectShape>Sphere</EffectShape>
                <WorkOrder>Uniform</WorkOrder>
                <WorkOrigin>Centre</WorkOrigin>
                <Offset x="0" y="0" z="-2.8" />
                <Radius>2.1</Radius>
                <Speed>1</Speed>
                <HarvestRatio>1</HarvestRatio>
                <DestroyVoxels>true</DestroyVoxels>
                <UpdateInterval>60</UpdateInterval>
                <ActivePower>0.002</ActivePower>
                <IdlePower>0.0001</IdlePower>
                <PickUpFloatings>true</PickUpFloatings>
                <DamageCharacters>true</DamageCharacters>
                <Action Type="Primary" SizeRatio="1" SpeedRatio="1" HarvestRatio="1" />
                <Action Type="Secondary" SizeRatio="1.35" SpeedRatio="1.5" HarvestRatio="0" />
                <Event Trigger="Firing">
                    <Animation>
                        <Subpart>DrillHead</Subpart>
                        <Type>Rotate</Type>
                        <Direction>0 0 -1</Direction>
                        <Speed>360</Speed>
                    </Animation>
                    <Sound>
                        <Name>ToolShipDrillIdle</Name>
                    </Sound>
                </Event>
                <Event Trigger="RayHit">
                    <ParticleEffect>
                        <Name>MaterialProperties/ShipDrill</Name>
                        <Location>Hit</Location>
                    </ParticleEffect>
                    <Sound>
                        <Name>MaterialProperties/ShipDrill</Name>
                    </Sound>
                </Event>
            </ToolValues>
        </Definition>

        <!-- =================================================================== -->
        <!-- 2. SMALL BLOCK DRILL                                                -->
        <!-- =================================================================== -->
        <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
            <Id>
                <TypeId>ConveyorSorter</TypeId>
                <SubtypeId>GVK_SmallBlockDrill</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_Drill</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\drill.dds</Icon>
            <Description>Description_Drill</Description>
            <CubeSize>Small</CubeSize>
            <GuiVisible>true</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="3" z="6" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Small\driller.mwm</Model>
            <PlaceDecals>false</PlaceDecals>
            <UseModelIntersection>true</UseModelIntersection>
            <UsesDeformation>false</UsesDeformation>
            <DeformationRatio>0.2</DeformationRatio>
            <Components>
                <Component Subtype="SteelPlate" Count="20" />
                <Component Subtype="Construction" Count="30" />
                <Component Subtype="LargeTube" Count="4" />
                <Component Subtype="Motor" Count="1" />
                <Component Subtype="Computer" Count="1" />
                <Component Subtype="SteelPlate" Count="12" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
            <Center x="1" y="1" z="5" />
            <MountPoints>
                <MountPoint Side="Back" StartX="0" StartY="1" EndX="3" EndY="2" Default="true" />
                <MountPoint Side="Right" StartX="0" StartY="1" EndX="2" EndY="2" />
                <MountPoint Side="Left" StartX="4" StartY="1" EndX="6" EndY="2" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Small\DrillerConstruction_1.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\DrillerConstruction_2.mwm" />
            </BuildProgressModels>
            <VoxelPlacement>
                <StaticMode>
                    <PlacementMode>OutsideVoxel</PlacementMode>
                    <MaxAllowed>0.2</MaxAllowed>
                    <MinAllowed>0</MinAllowed>
                </StaticMode>
                <DynamicMode>
                    <PlacementMode>OutsideVoxel</PlacementMode>
                    <MaxAllowed>0.2</MaxAllowed>
                    <MinAllowed>0.01</MinAllowed>
                </DynamicMode>
            </VoxelPlacement>
            <BlockPairName>GVK_Drill</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>20</BuildTimeSeconds>
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>190</PCU>
            <ResourceSinkGroup>Defense</ResourceSinkGroup>
            <PowerInput>0.002</PowerInput>
            <InventorySize>
                <X>1.6</X>
                <Y>1.6</Y>
                <Z>1.6</Z>
            </InventorySize>
            <ToolValues Type="Drill">
                <EffectShape>Sphere</EffectShape>
                <WorkOrder>Uniform</WorkOrder>
                <WorkOrigin>Centre</WorkOrigin>
                <Offset x="0" y="0" z="-0.8" />
                <Radius>1.5</Radius>
                <Speed>1</Speed>
                <HarvestRatio>1</HarvestRatio>
                <DestroyVoxels>true</DestroyVoxels>
                <UpdateInterval>60</UpdateInterval>
                <ActivePower>0.002</ActivePower>
                <IdlePower>0.0001</IdlePower>
                <PickUpFloatings>true</PickUpFloatings>
                <DamageCharacters>true</DamageCharacters>
                <Action Type="Primary" SizeRatio="1" SpeedRatio="1" HarvestRatio="1" />
                <Action Type="Secondary" SizeRatio="1.35" SpeedRatio="1.5" HarvestRatio="0" />
                <Event Trigger="Firing">
                    <Animation>
                        <Subpart>DrillHead</Subpart>
                        <Type>Rotate</Type>
                        <Direction>0 0 -1</Direction>
                        <Speed>360</Speed>
                    </Animation>
                    <Sound>
                        <Name>ToolShipDrillIdle</Name>
                    </Sound>
                </Event>
                <Event Trigger="RayHit">
                    <ParticleEffect>
                        <Name>MaterialProperties/ShipDrill</Name>
                        <Location>Hit</Location>
                    </ParticleEffect>
                    <Sound>
                        <Name>MaterialProperties/ShipDrill</Name>
                    </Sound>
                </Event>
            </ToolValues>
        </Definition>

        <!-- =================================================================== -->
        <!-- 3. ADVANCED SHIP DRILL (Prototech / Relic)                           -->
        <!-- =================================================================== -->
        <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
            <Id>
                <TypeId>ConveyorSorter</TypeId>
                <SubtypeId>GVK_LargePrototechDrill</SubtypeId>
            </Id>
            <DisplayName>Advanced Ship Drill</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\PrototechDrill.dds</Icon>
            <Description>High-efficiency Prototech-enhanced ship drill. Features accelerated rotation, increased excavation radius, and improved yield.</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>true</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="3" z="4" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\PrototechDrill.mwm</Model>
            <PlaceDecals>false</PlaceDecals>
            <UseModelIntersection>true</UseModelIntersection>
            <UsesDeformation>false</UsesDeformation>
            <DeformationRatio>0.2</DeformationRatio>
            <Components>
                <Component Subtype="SteelPlate" Count="180" />
                <Component Subtype="PrototechMachinery" Count="5" />
                <Component Subtype="Construction" Count="40" />
                <Component Subtype="LargeTube" Count="12" />
                <Component Subtype="Motor" Count="5" />
                <Component Subtype="Computer" Count="5" />
                <Component Subtype="SteelPlate" Count="120" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
            <!-- Mount points, model and build stages mirror vanilla LargeBlockPrototechDrill -->
            <MountPoints>
                <MountPoint Side="Right" StartX="0" StartY="0.5" EndX="0.4" EndY="2.5" />
                <MountPoint Side="Right" StartX="0.4" StartY="1.2" EndX="0.8" EndY="1.8" />
                <MountPoint Side="Left" StartX="3.6" StartY="0.5" EndX="4" EndY="2.5" />
                <MountPoint Side="Left" StartX="3.2" StartY="1.2" EndX="3.6" EndY="1.8" />
                <MountPoint Side="Top" StartX="0.5" StartY="0" EndX="2.5" EndY="0.4" />
                <MountPoint Side="Top" StartX="1.4" StartY="0.4" EndX="1.6" EndY="0.6" />
                <MountPoint Side="Bottom" StartX="0.5" StartY="3.6" EndX="2.5" EndY="4" />
                <MountPoint Side="Bottom" StartX="1.4" StartY="3.4" EndX="1.6" EndY="3.6" />
                <MountPoint Side="Back" StartX="0" StartY="0.3" EndX="3" EndY="2.7" Default="true" />
                <MountPoint Side="Back" StartX="0.3" StartY="0" EndX="2.7" EndY="0.3" />
                <MountPoint Side="Back" StartX="0.3" StartY="2.7" EndX="2.7" EndY="3" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\Large\PrototechDrill_Construction1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\Large\PrototechDrill_Construction2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\PrototechDrill_Construction3.mwm" />
            </BuildProgressModels>
            <VoxelPlacement>
                <StaticMode>
                    <PlacementMode>OutsideVoxel</PlacementMode>
                    <MaxAllowed>0.2</MaxAllowed>
                    <MinAllowed>0</MinAllowed>
                </StaticMode>
                <DynamicMode>
                    <PlacementMode>OutsideVoxel</PlacementMode>
                    <MaxAllowed>0.2</MaxAllowed>
                    <MinAllowed>0.01</MinAllowed>
                </DynamicMode>
            </VoxelPlacement>
            <BlockPairName>GVK_AdvancedDrill</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>45</BuildTimeSeconds>
            <Center x="1" y="1" z="3" />
            <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
            <DamagedSound>ParticleHeavyMech</DamagedSound>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>250</PCU>
            <ResourceSinkGroup>Defense</ResourceSinkGroup>
            <PowerInput>0.005</PowerInput>
            <InventorySize>
                <X>2.0</X>
                <Y>2.0</Y>
                <Z>2.0</Z>
            </InventorySize>
            <ToolValues Type="Drill">
                <EffectShape>Sphere</EffectShape>
                <WorkOrder>Uniform</WorkOrder>
                <WorkOrigin>Centre</WorkOrigin>
                <Offset x="0" y="0" z="-4" />
                <Radius>3.0</Radius>
                <Speed>1.5</Speed>
                <HarvestRatio>1.25</HarvestRatio>
                <DestroyVoxels>true</DestroyVoxels>
                <UpdateInterval>60</UpdateInterval>
                <ActivePower>0.005</ActivePower>
                <IdlePower>0.0002</IdlePower>
                <PickUpFloatings>true</PickUpFloatings>
                <DamageCharacters>true</DamageCharacters>
                <Action Type="Primary" SizeRatio="1" SpeedRatio="1" HarvestRatio="1" />
                <Action Type="Secondary" SizeRatio="1.35" SpeedRatio="1.5" HarvestRatio="0" />
                <Event Trigger="Firing">
                    <Animation>
                        <Subpart>PrototechDrill_Front</Subpart>
                        <Type>Rotate</Type>
                        <Direction>0 0 -1</Direction>
                        <Speed>540</Speed>
                    </Animation>
                    <Animation>
                        <Subpart>PrototechDrill_Mid</Subpart>
                        <Type>Rotate</Type>
                        <Direction>0 0 1</Direction>
                        <Speed>540</Speed>
                    </Animation>
                    <Sound>
                        <Name>ToolShipDrillIdle</Name>
                    </Sound>
                </Event>
                <Event Trigger="RayHit">
                    <ParticleEffect>
                        <Name>MaterialProperties/ShipDrill</Name>
                        <Location>Hit</Location>
                    </ParticleEffect>
                    <Sound>
                        <Name>MaterialProperties/ShipDrill</Name>
                    </Sound>
                </Event>
            </ToolValues>
        </Definition>

        <!-- =================================================================== -->
        <!-- 4. LARGE SHIP WELDER                                                -->
        <!-- =================================================================== -->
        <Definition xsi:type="MyObjectBuilder_ConveyorSorterDefinition">
            <Id>
                <TypeId>ConveyorSorter</TypeId>
                <SubtypeId>GVK_LargeShipWelder</SubtypeId>
            </Id>
            <DisplayName>DisplayName_Block_ShipWelder</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\Welder.dds</Icon>
            <Description>Description_ShipWelder</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>true</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="2" />
            <ModelOffset x="0" y="0" z="0" />
            <Center x="0" y="0" z="1" />
            <Model>Models\Cubes\Large\Welder.mwm</Model>
            <UseModelIntersection>true</UseModelIntersection>
            <UsesDeformation>false</UsesDeformation>
            <DeformationRatio>0.2</DeformationRatio>
            <Components>
                <Component Subtype="SteelPlate" Count="5" />
                <Component Subtype="Construction" Count="25" />
                <Component Subtype="LargeTube" Count="1" />
                <Component Subtype="Motor" Count="4" />
                <Component Subtype="Computer" Count="2" />
                <Component Subtype="Construction" Count="5" />
                <Component Subtype="SteelPlate" Count="15" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
